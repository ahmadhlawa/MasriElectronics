[Unit]
Description=Commerce backend (CLIENT_SLUG)
After=network-online.target

[Service]
Type=exec
User=commerce-CLIENT_SLUG
Group=commerce-CLIENT_SLUG
WorkingDirectory=PROJECT_PATH/backend
EnvironmentFile=PROJECT_PATH/backend/.env
ExecStart=PROJECT_PATH/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port BACKEND_PORT --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
ReadWritePaths=PROJECT_PATH/backend/data

[Install]
WantedBy=multi-user.target
