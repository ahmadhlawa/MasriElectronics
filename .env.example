# Masri Electronics local environment example. Never commit real credentials.
APP_ENV=development
APP_NAME=Masri Electronics
CLIENT_SLUG=masri-electronics
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002
SECRET_KEY=replace-with-a-secure-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=sqlite+pysqlite:///./data/masri_electronics_dev.db
CORS_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
STORAGE_PROVIDER=local
LOCAL_MEDIA_ROOT=./data/uploads
LOCAL_MEDIA_BASE_URL=/media
MAX_UPLOAD_SIZE_BYTES=5242880
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_OBJECT_PREFIX=masri-electronics/
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Store Owner
VITE_API_BASE_URL=http://127.0.0.1:8002/api/v1
VITE_MEDIA_BASE_URL=http://127.0.0.1:8002
